generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DESIGNER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

enum ExportFormat {
  PDF
  SVG
  DXF
  PNG
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  projects     Project[]

  @@map("users")
}

model Project {
  id          Int             @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  tags        Json?
  status      ProjectStatus   @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    DesignVersion[]
  exports     ExportRecord[]
  realtime    RealtimeState?

  @@index([userId])
  @@map("projects")
}

model DesignVersion {
  id        Int      @id @default(autoincrement())
  projectId Int
  version   Int      @default(1)
  data      Json
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, version])
  @@map("design_versions")
}

model ExportRecord {
  id         Int          @id @default(autoincrement())
  projectId  Int
  format     ExportFormat
  filePath   String
  exportedAt DateTime     @default(now())
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("exports")
}

model Template {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  category    String
  baseData    Json
  createdAt   DateTime @default(now())

  @@map("templates")
}

model RealtimeState {
  id        Int      @id @default(autoincrement())
  projectId Int      @unique
  data      Json
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("realtime_states")
}
